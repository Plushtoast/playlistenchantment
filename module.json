{
    "title": "Playlist Enchantment",
    "description": "A music player enchantment for Foundry: the Playlist Enchantment with library, artwork, tags, a shared queue, soundboards with ducking, guided uploads and player DJ access - on top of the playlist tweaks you already know.",
    "version": "2.0.3",
    "url": "https://github.com/Plushtoast/playlistenchantment",
    "manifest": "https://raw.githubusercontent.com/Plushtoast/playlistenchantment/foundry14/module.json",
    "download": "https://github.com/Plushtoast/playlistenchantment/releases/download/2.0.3/playlistenchantment-2.0.3.zip",
    "languages": [{
            "lang": "de",
            "name": "Deutsch",
            "path": "lang/de.json"
        },
        {
            "lang": "en",
            "name": "English",
            "path": "lang/en.json"
        },
        {
            "lang": "pl",
            "name": "Polski",
            "path": "lang/pl.json"
        }
    ],
    "esmodules": [
        "bundle/modules/init.js"
    ],
    "styles": [
        "styles/css/playlist.css"
    ],
    "id": "playlistenchantment",
    "authors": [{
        "name": "Huepfklotz"
    }],
    "persistentStorage": true,
    "socket": true,
    "compatibility": {
        "minimum": "14.367",
        "verified": "14.367",
        "maximum": "14"
    },
    "flags": {
        "hotReload": {
            "extensions": [
                "css",
                "html",
                "hbs",
                "json"
            ],
            "paths": [
                "templates",
                "styles/css",
                "lang"
            ]
        }
    }
}
