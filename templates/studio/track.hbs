<li class="pe-track {{#if playing}}playing{{/if}} {{#if paused}}paused{{/if}}{{#if tagFill}} pe-tag-fill{{/if}}"
    data-sound-id="{{id}}" data-playlist-id="{{playlistId}}" draggable="true"
    {{#if itemStyle}}style="{{itemStyle}}"{{/if}}>

    <button type="button" class="pe-track-cover" data-action="playTrack"
            {{#if cover}}style="background-image: url('{{cover}}')"{{/if}}
            data-tooltip="{{localize 'PLAYLISTENCHANTMENT.STUDIO.playTrack'}}">
        <i class="fa-solid {{#if loading}}fa-spinner fa-spin{{else if playing}}fa-volume-high{{else}}fa-play{{/if}}"></i>
    </button>

    <div class="pe-track-body">
        <span class="pe-track-name">
            {{#if playing}}<span class="pe-now-eq" aria-hidden="true"><i></i><i></i><i></i></span>{{/if}}
            <span class="pe-track-title">{{name}}</span>
        </span>
        <span class="pe-track-sub">
            {{#if source}}<span class="pe-track-source">{{source}}</span>{{/if}}
            {{> "modules/playlistenchantment/templates/studio/chips.hbs" tags=tags compact=true}}
            {{#if sharedCopies}}
            <span class="pe-track-shared" data-tooltip="{{usedInTooltip}}">
                <i class="fa-solid fa-link"></i>{{usedIn}}
            </span>
            {{/if}}
        </span>
    </div>

    <div class="pe-track-meta">
        <span class="pe-track-time">{{#if playing}}{{elapsed}} / {{/if}}{{duration}}</span>
        <i class="pe-track-channel {{channel.icon}} {{channel.css}}"
           data-tooltip="{{localize channel.label}}"></i>
        {{#if canControl}}
        <input type="range" class="pe-volume" min="0" max="1" step="0.05" value="{{volume}}"
               data-tooltip="{{localize 'PLAYLIST_SOUND.FIELDS.volume.label'}}" aria-label="{{localize 'PLAYLIST_SOUND.FIELDS.volume.label'}}" />
        {{/if}}
    </div>

    <div class="pe-track-actions">
        {{#if canControl}}
        <button type="button" class="pe-icon-button {{#if repeat}}active{{/if}}" data-action="toggleRepeat"
                data-tooltip="{{#if repeat}}{{localize 'PLAYLISTENCHANTMENT.SoundLoopOff'}}{{else}}{{localize 'PLAYLISTENCHANTMENT.SoundLoopOn'}}{{/if}}">
            <i class="fa-solid fa-repeat"></i>
        </button>
        <button type="button" class="pe-icon-button" data-action="toggleTrack"
                data-tooltip="{{#if playing}}{{localize 'PLAYLIST.SoundPause'}}{{else}}{{localize 'PLAYLIST.SoundPlay'}}{{/if}}">
            <i class="fa-solid {{#if playing}}fa-pause{{else}}fa-play{{/if}}"></i>
        </button>
        {{/if}}
        <button type="button" class="pe-icon-button" data-action="previewTrack"
                data-tooltip="{{localize 'PLAYLISTENCHANTMENT.STUDIO.previewHint'}}">
            <i class="fa-solid fa-headphones"></i>
        </button>
        <button type="button" class="pe-icon-button" data-action="enqueue"
                data-tooltip="{{localize 'PLAYLISTENCHANTMENT.QUEUE.add'}}">
            <i class="fa-solid fa-list-ol"></i>
        </button>
        {{#if canEdit}}
        <button type="button" class="pe-icon-button" data-action="editTrack"
                data-tooltip="{{localize 'PLAYLISTENCHANTMENT.EDITOR.edit'}}">
            <i class="fa-solid fa-pen-to-square"></i>
        </button>
        <button type="button" class="pe-icon-button pe-danger" data-action="removeTrack"
                data-tooltip="{{localize 'PLAYLISTENCHANTMENT.LIBRARY.removeTrack'}}">
            <i class="fa-solid fa-trash"></i>
        </button>
        {{/if}}
    </div>
</li>
