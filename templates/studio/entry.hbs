<div class="pe-entry directory-item pe-drop-target {{channel.css}} {{#if selected}}selected{{/if}} {{#if playing}}playing{{/if}}{{#if tagFill}} pe-tag-fill{{/if}}"
     data-entry-id="{{id}}" data-playlist-id="{{id}}" data-action="selectPlaylist"
     {{#if itemStyle}}style="{{itemStyle}}"{{/if}}>
    <span class="pe-entry-cover" {{#if cover}}style="background-image: url('{{cover}}')"{{/if}}>
        {{#unless cover}}<i class="{{channel.icon}}"></i>{{/unless}}
    </span>
    <span class="pe-entry-body">
        <span class="pe-entry-name" data-tooltip="{{name}}">{{name}}</span>
        <span class="pe-entry-meta">
            <span data-tooltip="{{localize 'PLAYLISTENCHANTMENT.STUDIO.tracks'}}">{{trackCount}}</span>
            {{#if hasDJs}}
            <i class="fa-solid fa-headphones pe-dj-badge"
               data-tooltip="{{localize 'PLAYLISTENCHANTMENT.DJ.badge'}}"></i>
            {{/if}}
            {{#if tags.length}}
            <span class="pe-pips">
                {{#each tags}}
                <span class="pe-pip" style="--pe-tag-color: {{color}}" data-tooltip="{{label}}"></span>
                {{/each}}
            </span>
            {{/if}}
        </span>
    </span>
    <button type="button" class="pe-icon-button pe-pin {{#if pinned}}pinned{{/if}}" data-action="togglePin"
            data-tooltip="{{#if pinned}}{{localize 'PLAYLISTENCHANTMENT.LIBRARY.unpin'}}{{else}}{{localize 'PLAYLISTENCHANTMENT.LIBRARY.pin'}}{{/if}}">
        <i class="fa-{{#if pinned}}solid{{else}}regular{{/if}} fa-thumbtack"></i>
    </button>
    {{#if playing}}<i class="fa-solid fa-volume-high pe-entry-playing"></i>{{/if}}
</div>
