<div class="pe-entry pe-drop-target {{channel.css}} {{#if selected}}selected{{/if}} {{#if playing}}playing{{/if}}"
     data-playlist-id="{{id}}" data-action="selectPlaylist"
     {{#if color}}style="--pe-accent: {{color}}"{{/if}}
     data-tooltip="{{name}}">
    <span class="pe-entry-cover" {{#if cover}}style="background-image: url('{{cover}}')"{{/if}}>
        {{#unless cover}}<i class="{{channel.icon}}"></i>{{/unless}}
    </span>
    <span class="pe-entry-body">
        <span class="pe-entry-name">{{name}}</span>
        <span class="pe-entry-meta">
            {{trackCount}} {{localize "PLAYLISTENCHANTMENT.STUDIO.tracks"}}
            {{#if hasDJs}}
            <i class="fa-solid fa-headphones pe-dj-badge"
               data-tooltip="{{localize 'PLAYLISTENCHANTMENT.DJ.badge'}}"></i>
            {{/if}}
        </span>
        {{#if tags.length}}
        <span class="pe-chips">
            {{#each tags}}
            <span class="pe-chip" style="--pe-tag-color: {{color}}; --pe-tag-foreground: {{foreground}}">
                <span class="pe-chip-label">{{label}}</span>
                {{#if ../canEdit}}
                <button type="button" class="pe-chip-remove" data-action="untag" data-tag="{{tag}}"
                        data-tooltip="{{localize 'PLAYLISTENCHANTMENT.STUDIO.removeTag'}}">
                    <i class="fa-solid fa-xmark"></i>
                </button>
                {{/if}}
            </span>
            {{/each}}
        </span>
        {{/if}}
    </span>
    <button type="button" class="pe-icon-button pe-pin {{#if pinned}}pinned{{/if}}" data-action="togglePin"
            data-tooltip="{{#if pinned}}{{localize 'PLAYLISTENCHANTMENT.LIBRARY.unpin'}}{{else}}{{localize 'PLAYLISTENCHANTMENT.LIBRARY.pin'}}{{/if}}">
        <i class="fa-{{#if pinned}}solid{{else}}regular{{/if}} fa-thumbtack"></i>
    </button>
    {{#if playing}}<i class="fa-solid fa-volume-high pe-entry-playing"></i>{{/if}}
</div>
