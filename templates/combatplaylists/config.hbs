<form class="combat-playlist-config-form flexcol">
    <p class="hint">{{ localize "PLAYLISTENCHANTMENT.CombatConfigHint" }}</p>
    {{#if tree.hasContent}}
    <ol class="directory-list plain">
        {{#each tree.children}}
        {{> "modules/playlistenchantment/templates/combatplaylists/folder-partial.hbs" node=this folder=this.folder }}
        {{/each}}
        {{#each tree.entries}}
        {{> "modules/playlistenchantment/templates/combatplaylists/entry-partial.hbs" }}
        {{/each}}
    </ol>
    {{else}}
    <p class="hint">{{ localize "PLAYLISTENCHANTMENT.CombatConfigEmpty" }}</p>
    {{/if}}
    <footer class="form-footer flexrow">
        <button type="button" data-action="save">
            <i class="fas fa-save"></i> {{ localize "Save" }}
        </button>
    </footer>
</form>
