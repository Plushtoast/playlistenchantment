<div class="pe-controls">
<div class="pe-studio-bar global-control">
    <button type="button" class="pe-studio-button" data-action="openStudio" draggable="true"
            data-tooltip="{{localize 'PLAYLISTENCHANTMENT.STUDIO.openHint'}}">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <span>{{localize "PLAYLISTENCHANTMENT.STUDIO.open"}}</span>
    </button>
</div>

<div class="global-volume global-control {{#if controls.expanded}}expanded{{/if}}">
    <header class="playlist-header" data-action="volumeExpand">
        <i class="expand fa-solid fa-angle-up" inert></i>
        <strong>{{ localize "PLAYLIST.VOLUME.CONTROLS" }}</strong>
    </header>
    <div class="expandable">
        <div class="wrapper">
            <ol class="plain channel-volume-list">
                {{#each channelControls}}
                {{> "modules/playlistenchantment/templates/playlist/channel-controls.hbs" }}
                {{/each}}
                {{#if @root.user.isGM}}
                <li class="flexrow combat-autoswitch" data-tooltip="{{localize 'PLAYLISTENCHANTMENT.CombatAutoSwitch'}}">
                    <label>{{localize "PLAYLISTENCHANTMENT.CombatAutoSwitchLabel"}}</label>
                    <i class="volume-icon fas fa-swords" inert></i>
                    <div class="flexrow flex2 combat-autoswitch-controls">
                        <button type="button" class="combat-playlist-config inline-control icon fa-solid fa-cog noflex" data-action="configureCombatPlaylists" data-tooltip="{{localize 'PLAYLISTENCHANTMENT.CombatConfigure'}}"></button>
                        <input type="checkbox" class="enchanment-checkbox noflex" name="autoCombatSwitch" value="true" {{checked enchantment.autoCombatSwitch}}/>
                    </div>
                </li>
                {{/if}}
            </ol>
        </div>
    </div>
</div>
</div>
